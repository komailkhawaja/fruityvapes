# Copy this file to .env and fill in your own values.

# Port the web server runs on
PORT=3000

# Secret used to sign admin login sessions - change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# A unique ID for your vending machine (must match MACHINE_ID in the ESP32 firmware)
MACHINE_ID=VM01

# MQTT broker used to talk to the ESP32 remotely.
# For quick testing you can use the free public broker below - but ANYONE else using
# broker.hivemq.com could theoretically publish to the same topic if they guessed your
# MACHINE_ID, so switch to a private broker (see README) once you're past testing.
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
